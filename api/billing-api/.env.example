# Local Billing API configuration. Run pnpm --filter @crimfig/billing-api dev
# so Nest reads api/billing-api/.env. Railway uses its service variables instead.
NODE_ENV=development
PORT=3008
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
DB_SSL=false
# Must match Auth's access-token signing configuration.
JWT_ACCESS_SECRET=
# TEST keys only in local development. Never put the secret in a frontend .env.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test
BILLING_WEB_URL=http://localhost:3007/
# Explicit grants; empty means no financial operator access.
BILLING_SETTLEMENT_OPERATOR_IDS=[]
BILLING_SUBSCRIPTION_RENEWALS_ENABLED=false
