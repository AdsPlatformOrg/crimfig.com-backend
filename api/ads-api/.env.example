# Ads API local configuration. Copy to `.env`; `.env` is gitignored.
NODE_ENV=development
PORT=3004
ADS_PUBLIC_URL=http://localhost:3004

# PostgreSQL
DATABASE_URL=
DB_SSL=false

# Location autocomplete (server-side only; never NEXT_PUBLIC_*)
GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=

# Firebase Admin for media upload/preview
GSA_PROJECT_ID=
GSA_CLIENT_EMAIL=
GSA_PRIVATE_KEY=
GSA_STORAGE_BUCKET=

# Keep false until the PLAN-0035 Video gates pass
CREATIVE_VIDEO_AUTHORING_ENABLED=false

# Global-only until location providers and trusted edge geography are configured
GEO_TARGETING_ENABLED=false
