# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── Environment files (NEVER commit real .env files) ─────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
# Only .env.example and .env.test are safe to commit
!.env.example
!.env.test

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────────────────────
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Turborepo ────────────────────────────────────────────────────────────────
.turbo/

# ─── Docker ───────────────────────────────────────────────────────────────────
*.env.docker

# ─── Drizzle ─────────────────────────────────────────────────────────────────
# Migrations are committed; only generated snapshots are ignored
database/drizzle/__snapshots__/
