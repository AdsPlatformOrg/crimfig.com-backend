NODE_ENV=development
PORT=4000

# PostgreSQL — provided by @crimfig/database package
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crimfig_core
DB_USER=crimfig_user
DB_PASSWORD=
DB_SSL=false

# JWT Secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OAuth / OIDC
OAUTH_ISSUER=https://auth.crimfig.com
OAUTH_AUTH_CODE_EXPIRES_SECONDS=300

# Redis (session cache, rate limiting, pub-sub)
REDIS_URL=redis://localhost:6379

# Email — Brevo Transactional API (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
EMAIL_FROM=noreply@crimfig.com
EMAIL_FROM_NAME=CrimFig

# App encryption key for MFA secrets (AES-256) — generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Frontend app base URLs (for redirect & CORS whitelisting)
AUTH_WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
