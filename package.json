{
  "name": "crimfig-backend",
  "version": "0.0.1",
  "private": true,
  "description": "CrimFig Backend — NestJS microservices, Drizzle ORM, Auth, Audit, Ads, Chat, Reels, Stream, Notifications",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0",
    "npm": "PLEASE_USE_PNPM_INSTEAD",
    "yarn": "PLEASE_USE_PNPM_INSTEAD"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @crimfig/database db:generate",
    "db:migrate": "pnpm --filter @crimfig/database db:migrate",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
