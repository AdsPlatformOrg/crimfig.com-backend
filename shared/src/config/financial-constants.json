  "_comment": "CRIMFIG CANONICAL FINANCIAL & PRICING CONSTANTS",
  "_warning": "DO NOT MODIFY THIS FILE WITHOUT DOUBLE CHECKING AND EXPLICIT DIRECTIVE FROM JED. These figures establish core mathematical solvency, database constraints, auction score floors, and immutable revenue split contracts across the entire ecosystem.",
  "version": "1.0.0",
  "updatedAt": "2026-10-24",
  "pricingFloors": {
    "baseCpmUsd": 0.5,
    "baseCpmUsdCents": 50,
    "baseCpcUsd": 0.1,
    "baseCpcUsdCents": 10,
    "minCampaignBudgetUsd": 5,
    "minCampaignBudgetUsdCents": 500,
