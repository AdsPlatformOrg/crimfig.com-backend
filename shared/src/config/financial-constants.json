    "bonusPromoterIncentiveDefaultFromDynamicPoolPercent": 5,
    "clearanceHoldHours": 72
  },
  "rewardsValuation": {
    "pointsPerUsd": 100,
    "centsPerPoint": 1,
    "minRedemptionPoints": 1000
  },
  "temporalTrackingAndSolvency": {
    "solvencyInvariant": "rewards_fund.cash_balance_usd_cents == (rewards_fund.allocated_usd_cents + rewards_fund.available_usd_cents + rewards_fund.funded_pending_usd_cents) AND rewards_fund.allocated_usd_cents == SUM(user_outstanding_points * point_valuation_cents) AND rewards_fund.available_usd_cents >= 0 AND campaign_bonus_reserves.allocated_microusd == (campaign_bonus_reserves.consumed_microusd + campaign_bonus_reserves.released_microusd + campaign_bonus_reserves.remaining_microusd)",
    "fractionalCentAccounting": {
      "strategy": "INTEGER_MICROUSD_ACCUMULATOR",
      "subCentUnitUsd": 0.000001,
      "microusdPerIntegerCent": 10000,
      "description": "One integer accumulator unit represents $0.000001 USD (1 microdollar; 0.0001 USD cents). 10,000 microdollars equal 1 integer USD cent. Calculations use exact integer arithmetic; whole cents are swept into available cash only when accumulated microdollars >= 10,000. Residual microdollars carry forward without rounding."
    },
    "milestoneFundingProtection": {
      "strategy": "FUNDED_LAUNCH_RESERVE_THEN_ERA_ADAPTATION",
      "requireAvailableCashBacking": true,
      "allowDeferredMilestoneIssuance": true,
      "disallowSyntheticPointsDeficit": true,
      "description": "Milestones are permanent prestige badges. Cash-convertible points are awarded only when backed 1:1 by real unallocated Rewards Fund cash (or dedicated seed reserve). If cash is insufficient, badge status is unlocked and point issuance is queued under pending_liability_usd_cents until funded."
    },
    "requireEarnedAtMicrosecondPrecision": true,
    "rateVersion": 1,
    "eraSchedule": [
      {
        "era": 1,
        "name": "Genesis Foundation",
        "description": "Full baseline emission rates to bootstrap promoter participation",
        "rateMultiplier": 1,
        "effectiveFrom": "2026-10-24"
      },
      {
        "era": 2,
        "name": "Scale Adaptation",
        "description": "Controlled 25% rate reduction preserving 100% solvency across high network volume",
        "rateMultiplier": 0.75,
        "effectiveFrom": "TBD_AT_SCALE"
      }
    ],
    "rewardsFundLedgerSchema": {
      "balances": [
        "cash_balance_usd_cents",
        "allocated_usd_cents",
        "available_usd_cents",
        "funded_pending_usd_cents",
        "fractional_residual_microusd"
      ],
      "reconciliationRule": "cash_balance_usd_cents == allocated_usd_cents + available_usd_cents + funded_pending_usd_cents"
    },
    "rewardLifecycleStates": {
      "states": [
        {
          "state": "ACHIEVED_UNFUNDED",
          "description": "Milestone prestige badge unlocked permanently; cash-convertible point grant is deferred and held in deferred_reward_entitlements outside cash liability until backed."
        },
        {
          "state": "FUNDED_PENDING",
          "description": "Real cash is reserved 1:1 in the Rewards Fund; points are queued during clearance or processing and counted in funded_pending_usd_cents."
        },
        {
          "state": "ISSUED_AVAILABLE",
          "description": "Whole points minted and fully backed 1:1 by real cash, available for withdrawal/redemption under normal clearance rules."
        }
      ],
      "entitlementsLedger": "deferred_reward_entitlements",
      "idempotencyConstraint": "UNIQUE(user_id, reward_key)"
    },
    "fractionalRewardValueAccrual": {
      "strategy": "PER_USER_MICROUSD_VALUE_ACCUMULATOR",
      "microusdPerPoint": 10000,
      "era1NominalLoopValueMicrousd": 100000,
      "era2NominalLoopValueMicrousd": 75000,
      "description": "Era multiplier applies to monetary value (e.g. Era 2 10-point loop = 75,000 microdollars = $0.075). Users accrue microdollar reward value; whole points are minted only when accumulated funded value >= 10,000 microdollars (1 point). Residual microdollars carry forward across events and era boundaries without rounding inflation."
    }
  },
